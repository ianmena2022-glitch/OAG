{
  "name": "ogsa-auditoria",
  "version": "1.5.1",
  "description": "OGSA Sistema de Auditorías Comerciales",
  "main": "out/main/index.js",
  "author": "OGSA Auditores",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-table": "^8.20.5",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.ogsa.auditoria",
    "productName": "OGSA Auditorías",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "ianmena2022-glitch",
      "repo": "OAG"
    },
    "win": {
      "target": "nsis",
      "artifactName": "ogsa-auditoria-setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OGSA Auditorías"
    }
  }
}
